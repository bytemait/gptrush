# Docker Compose (copy this file to .env and replace the secrets)
APP_PORT=3000
APP_URL=http://localhost:3000
POSTGRES_USER=firstlight
POSTGRES_DB=firstlight
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_POOL_SIZE=20
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# For running npm run dev directly outside Docker, set DATABASE_URL separately:
# DATABASE_URL=postgres://firstlight:YOUR_PASSWORD@localhost:5432/firstlight
